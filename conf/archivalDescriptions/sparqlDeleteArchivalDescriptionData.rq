PREFIX ehri_units: <http://lod.ehri-project-test.eu/units/>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX ehri: <http://lod.ehri-project-test.eu/ontology#>

DELETE {
    ?s ?p ?o .
} WHERE {
    {
        # All the main triples where the unit is the subject except those that are generated as part of other set of mapping rules
        # (including the links to its children, which are generated by the children's mappings)
        ?s ?p ?o .
        FILTER(?s = ehri_units:<$entityId>
            && ?p != rico:includesOrIncluded
            && ?p != rico:thingIsTargetOfRelation
            && ?p != rico:thingIsSourceOfRelation
            && ?p != ehri:hasCopy
            && ?p != ehri:isCopyOf)
    }
    UNION
    {
        # Connected instances that can be completely removed as they are only bound to the unit
        ?s ?p ?o ;
            a ?connectedClasses ;
            ?inverseProperty ?unit .
         VALUES ?connectedClasses { rico:Title rico:Activity rico:Identifier }
         FILTER(?unit = ehri_units:<$entityId>)
    }
    UNION
    {
        # All the triples where the unit is the object except those that are generated by the links mapping,
        # and the links from its children, which are generated by the children's mappings
        ?s ?p ?o .
        FILTER(?o = ehri_units:<$entityId>
            && ?p NOT IN (rico:relationHasSource, rico:relationHasTarget, ehri:hasCopy, ehri:isCopyOf, rico:isOrWasIncludedIn))
    }
}