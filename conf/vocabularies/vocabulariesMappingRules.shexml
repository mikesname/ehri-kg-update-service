FUNCTIONS transformers <scala: conf/vocabularies/Transformers.scala>
FUNCTIONS validators <scala: conf/vocabularies/Validators.scala>
SOURCE concepts <stdin>
ITERATOR concept_iterator <jsonpath: $.data.query> {
	PUSHED_FIELD item_id <identifier>
	FIELD uri <uri>
	FIELD see_also <seeAlso>
	FIELD latitude <latitude>
	FIELD longitude <longitude>
  PUSHED_FIELD vocabulary_id <vocabulary.identifier>
  FIELD broader_length <broader.length()>
  ITERATOR broader <broader[*]> {
    FIELD id <identifier>
    POPPED_FIELD vocabulary_set <vocabulary_id>
  }
  ITERATOR narrower <narrower[*]> {
    FIELD id <identifier>
    POPPED_FIELD vocabulary_set <vocabulary_id>
  }
  ITERATOR descriptions <descriptions[*]> {
    FIELD name <name>
    FIELD langcode <languageCode>
    FIELD langcode_variant <identifier>
    FIELD alt_label <altLabel>
    FIELD scope_note <scopeNote>
  }
}
ITERATOR data <jsonpath: $.data> {
  FIELD item_id <query.identifier>
  FIELD test <query>
}
EXPRESSION concept <concepts.concept_iterator>
EXPRESSION test2 <concepts.data>

ehri:Concept ehri_vocabs:[transformers.generateVocabUri(concept.vocabulary_id, concept.item_id)] {
  a skos:Concept ;
  # this is the closest conversion reachable at the moment due to limitations in ShExML and JSONPath
  skos:prefLabel [concept.descriptions.name] @[concept.descriptions.langcode MATCHING langcode_two_digit_equivalent] ;
  skos:altLabel [concept.descriptions.alt_label] @[concept.descriptions.langcode MATCHING langcode_two_digit_equivalent] ;
  skos:broader ehri_vocabs:[transformers.generateVocabUri(concept.broader.vocabulary_set, concept.broader.id)] ;
  skos:narrower ehri_vocabs:[transformers.generateVocabUri(concept.narrower.vocabulary_set, concept.narrower.id)] ;
  rdfs:seeAlso [concept.see_also] ;
  skos:inScheme ehri_vocabs:[concept.vocabulary_id] ;
  geo:lat [concept.latitude] xsd:decimal ;
  geo:long [concept.longitude] xsd:decimal ;
  skos:scopeNote [concept.descriptions.scope_note] @[concept.descriptions.langcode MATCHING langcode_two_digit_equivalent] ;
  # This cannot be generated at the moment, JSONPath functions are not supported in ShExML
  #skos:topConceptOf ehri_vocabs:[concept.vocabulary_id IF validators.greaterThanZero(concept.broader_length)] ;
}

ehri:ConceptScheme ehri_vocabs:[concept.vocabulary_id] {
  # This cannot be generated at the moment, JSONPath functions are not supported in ShExML
  #skos:hasTopConcept ehri_vocabs:[transformers.generateVocabUri(concept.vocabulary_id, concept.item_id) IF validators.greaterThanZero(concept.broader_length)] ;
}