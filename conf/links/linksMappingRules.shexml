    # The object is a documentary unit
    rico:relationHasTarget ehri_units:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectDocumentaryUnit(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] ;
    # The object is an institution
    rico:relationHasTarget ehri_institutions:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectInstitution(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] ;
    # The subject is a documentary unit
    rico:relationHasSource ehri_units:[links.loc_cop.targets.source_id IF validators.isDocumentaryUnit(links.loc_cop.targets.source_type)] ;
    # The subject is an institution
    rico:relationHasSource ehri_institutions:[links.loc_cop.targets.source_id IF validators.isInstitution(links.loc_cop.targets.source_type)] ;
}
# unit to unit or institution to unit (inverse)
ehri:HoldingLocationOfCopiesInverse ehri_units:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectDocumentaryUnit(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] {
    rico:thingIsSourceOfRelation @ehri:IsCopyOfLocCop ;
    #completion of hasCopy links
    rico:thingIsTargetOfRelation ehri_has_copy_relations:[links.loc_cop.targets.identifier] ;
    # direct link
    ehri:isCopyOf ehri_units:[links.loc_cop.targets.source_id IF validators.isDocumentaryUnit(links.loc_cop.targets.source_type)] ;
    ehri:isCopyOf ehri_institutions:[links.loc_cop.targets.source_id IF validators.isInstitution(links.loc_cop.targets.source_type)] ;
}
# unit to institution or institution to institution (inverse)
ehri:InstitutionLocationOfCopiesInverse ehri_institutions:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectInstitution(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] {
    rico:thingIsSourceOfRelation @ehri:IsCopyOfLocCop ;
    #completion of hasCopy links
    rico:thingIsTargetOfRelation ehri_has_copy_relations:[links.loc_cop.targets.identifier] ;
    # direct link
    ehri:isCopyOf ehri_units:[links.loc_cop.targets.source_id IF validators.isDocumentaryUnit(links.loc_cop.targets.source_type)] ;
    ehri:isCopyOf ehri_institutions:[links.loc_cop.targets.source_id IF validators.isInstitution(links.loc_cop.targets.source_type)] ;
}
#n-ary relation for ehri:IsCopyOf location of copies
ehri:IsCopyOfLocCop ehri_is_copy_of_relations:[links.loc_cop.targets.identifier] {
    a ehri:IsCopyOfRelation ;
    rico:generalDescription [links.loc_cop.targets.description] ;
    # The object is an institution
    rico:relationHasTarget ehri_institutions:[links.loc_cop.targets.source_id IF validators.isInstitution(links.loc_cop.targets.source_type)] ;
    # The object is a documentary unit
	rico:relationHasTarget ehri_units:[links.loc_cop.targets.source_id IF validators.isDocumentaryUnit(links.loc_cop.targets.source_type)] ;
    # The subject is a documentary unit
    rico:relationHasSource ehri_units:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectDocumentaryUnit(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] ;
    # The subject is an institution
    rico:relationHasSource ehri_institutions:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectInstitution(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] ;
}