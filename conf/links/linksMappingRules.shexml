    ehri:hasCopy ehri_institutions:[links.loc_cop.targets.target_id IF validators.areSourceAndTargetDifferentAndIsSubjectInstitution(links.loc_cop.targets.source_id, links.loc_cop.targets.target_id, links.loc_cop.targets.type)] ;
